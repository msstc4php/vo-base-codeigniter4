{
    "name": "msstc4php/vo-base-codeigniter4",
    "description": "CodeIgniter 4 Entity and Model casts and a validation rule set for msstc4php/vo-base.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "value-object",
        "codeigniter",
        "codeigniter4",
        "entity",
        "cast",
        "validation",
        "bridge",
        "ddd"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/msstc4php/vo-base"
        }
    ],
    "require": {
        "php": ">=8.4",
        "codeigniter4/framework": "^4.7.4",
        "msstc4php/vo-base": "^1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.76",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": ">=11.0",
        "rector/rector": "^2.1",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\CodeIgniter4\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MSSTC4PHP\\ValueObject\\CodeIgniter4\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Maxim Shamaev",
            "email": "maxim.shamaev@gmail.com"
        }
    ],
    "extra": {
        "bundle-standard": {
            "kind": "library",
            "runtime": "php84"
        }
    }
}
